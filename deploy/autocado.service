# systemd unit for running Autocado on a Raspberry Pi.
# Install:  sudo cp deploy/autocado.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now autocado
# Logs:     journalctl -u autocado -f
# Edit User / WorkingDirectory if your user or path differ.

[Unit]
Description=Autocado kitchen shopping assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/autocado
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3456
# Lets "Sign in myself" open a browser window on the Pi's own screen.
Environment=DISPLAY=:0
# Lets Autocado also answer on port 80, so phones can open http://autocado.local
# without ":3456". Remove to keep it on 3456 only.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/node --env-file-if-exists=.env server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
