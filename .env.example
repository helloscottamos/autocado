# Copy to .env and adjust. All optional.

# PORT=3456
# Use 0.0.0.0 to reach Autocado from phones / the kitchen mirror on your Wi-Fi.
# HOST=127.0.0.1

# Reads recipe photos and pasted recipes. Can also be set in Settings.
# ANTHROPIC_API_KEY=sk-ant-...
# AUTOCADO_MODEL=claude-opus-5-5

# AUTOCADO_DATA_DIR=./data

# 1 = demo mode with a fake Ocado catalogue (no account needed)
# OCADO_MOCK=0
